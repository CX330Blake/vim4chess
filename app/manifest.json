{
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "__MSG_appDescription__",
  "icons": {
    "16": "images/icon-16.png",
    "128": "images/icon-128.png"
  },
  "default_locale": "en",
  "host_permissions": [
    "https://www.chess.com/"
  ],
  "action": {
    "default_icon": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "css": [
        "styles/main.css"
      ],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "build.js"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{c6de6cf7-c132-4b12-906e-7769a399b5dc}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
